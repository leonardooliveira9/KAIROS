# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.

# --- Login e permissões -----------------------------------------------------
# Assina os cookies de sessão. Gere com:  node scripts/generate-session-secret.js
SESSION_SECRET=
# E-mail(s) do primeiro admin: vira admin ao CONFIRMAR o e-mail da conta (link enviado ou login com Google), só enquanto não existir nenhum admin.
# Depois, outros admins podem ser promovidos em /admin/usuarios.
ADMIN_EMAILS=

# --- Firebase: login com Google ---------------------------------------------
# Console Firebase > Configurações do projeto > Seus apps > Web. São valores públicos.
# Ative Authentication > Google.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true = a janela do login com Google abre no domínio da loja (/__/auth/...), e não em firebaseapp.com,
# que alguns navegadores, extensões e antivírus bloqueiam (janela fica em branco). Antes de ligar, adicione
#   https://SEU-DOMINIO/__/auth/handler
# em Google Cloud > APIs e serviços > Credenciais > cliente OAuth "Web client" > URIs de redirecionamento autorizados.
# NEXT_PUBLIC_FIREBASE_AUTH_PROXY=true

# --- Pagamento PIX (AbacatePay, Checkout Transparente v2) -------------------
# Sem chave: o checkout gera um PIX estático na chave definida em lib/store-config.ts
# e você confirma o pagamento manualmente no painel.
# Com chave: QR Code dinâmico e confirmação automática.
ABACATEPAY_API_KEY=
# Segredo do webhook. Cadastre na AbacatePay a URL:
#   https://SEU-DOMINIO/api/payment/webhook?webhookSecret=<este valor>
ABACATEPAY_WEBHOOK_SECRET=

# --- Fotos dos produtos (Vercel Blob) -----------------------------------------
# Na Vercel: projeto > Storage > Create > Blob > conectar ao projeto. A variável é criada sozinha.
# Sem ela, em desenvolvimento as fotos enviadas no admin vão para public/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Frete dos Correios (PAC e SEDEX) pelo Melhor Envio ----------------------
# Token em melhorenvio.com.br > Integrações > Permissões de acesso > Gerar novo token, com a permissão
# "shipping-calculate". Defina também o CEP de origem em lib/store-config.ts (shipping.originCep).
# Sem token, o checkout cobra o frete reserva de lib/store-config.ts (shipping.fallback).
MELHOR_ENVIO_TOKEN=
# true para usar o ambiente de testes (sandbox.melhorenvio.com.br); o token precisa ser do sandbox
# MELHOR_ENVIO_SANDBOX=true

# --- E-mail (Gmail com senha de app) --------------------------------------
# Usado no formulário de contato, na verificação de e-mail e no "esqueci minha senha".
# Sem estas variáveis, em desenvolvimento os links de verificação/redefinição vão para o console.
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_EMAIL_TO=
# Endereço público da loja, usado nos links enviados por e-mail (obrigatório em produção)
SITE_URL=

# --- Banco de dados (contas e pedidos) -----------------------------------
# OBRIGATÓRIO na Vercel: sem banco, cada servidor tem sua própria memória e o login "cai".
# MySQL ou MariaDB acessível pela internet. As tabelas são criadas sozinhas no primeiro uso.
#   mysql://usuario:senha@host:3306/nome_do_banco
DATABASE_URL=
# true se o provedor exige conexão segura (TLS); "insecure" aceita certificado autoassinado
# DATABASE_SSL=true
# Certificado (CA) do provedor, em PEM, para provedores com certificado próprio (ex.: Aiven > Overview > CA certificate).
# Liga o TLS sozinho e confere o servidor por ele. Na Vercel, cole o conteúdo do arquivo inteiro, com as linhas BEGIN/END.
# DATABASE_CA=
# Sem DATABASE_URL, os dados ficam em arquivos JSON nesta pasta (padrão .data) — só para desenvolvimento/VPS.
# DATA_DIR=
