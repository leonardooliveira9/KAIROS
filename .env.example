# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.

# --- Painel administrativo (/admin) ---------------------------------------
# Gere os dois valores com:  node scripts/generate-password-hash.js "sua-senha-forte"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Pagamento PIX (AbacatePay, Checkout Transparente v2) -------------------
# Sem chave: o checkout gera um PIX estático na chave definida em lib/store-config.ts
# e você confirma o pagamento manualmente no painel.
# Com chave: QR Code dinâmico e confirmação automática.
ABACATEPAY_API_KEY=
# Segredo do webhook. Cadastre na AbacatePay a URL:
#   https://SEU-DOMINIO/api/payment/webhook?webhookSecret=<este valor>
ABACATEPAY_WEBHOOK_SECRET=

# --- Formulário de contato (Gmail com senha de app) -------------------------
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_EMAIL_TO=

# --- Armazenamento de pedidos ---------------------------------------------
# Pasta onde os pedidos são gravados (padrão: .data). Na Vercel o disco não persiste:
# use um banco de dados antes de vender por lá.
# DATA_DIR=
